{
  "name": "arcabot-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "astro check",
    "check": "astro check && npm test",
    "build": "astro build && node scripts/check-built-site.mjs",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.1.18",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "sharp": "^0.35.3",
    "typescript": "5.9.3",
    "wrangler": "^4.125.0"
  }
}
